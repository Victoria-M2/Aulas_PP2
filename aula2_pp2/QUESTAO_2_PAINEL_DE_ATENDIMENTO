#include <stdio.h>
int main(){

    int numero;
    printf("Menu\n 1 - Financeiro\n 2 - Suporte Técnico\n 3 - Recursos Humanos\n 4 - Comercial\n 5 - Cancelamento\n");
    
    printf("Digite de 1 a 5 para navegar no menu: ");
    scanf("%d", &numero);

    switch (numero){
        case 1:
        printf("Encaminhando para o setor Financeiro...");
        break;

        case 2:
        printf("Encaminhando para o Suporte Técnico...");
        break;

        case 3:
        printf("Encaminhando para Recursos Humanos...");
        break;

        case 4:
        printf("Encaminhando para o setor Comercial...");
        break;

        case 5:
        printf("Encaminhando para o setor de Cancelamento...");
        break;

        default:
        printf("Opção de atendimento inválida.");
        break;
    }
    
    return 0;
}
